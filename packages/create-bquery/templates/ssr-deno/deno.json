{
  "tasks": {
    "dev": "deno run --watch --allow-net --allow-env src/server.ts",
    "start": "deno run --allow-net --allow-env src/server.ts",
    "test": "deno test --allow-env --allow-read",
    "check": "deno check src test"
  },
  "imports": {
    "@bquery/bquery": "npm:@bquery/bquery@{{bqueryRange}}",
    "@bquery/bquery/": "npm:/@bquery/bquery@{{bqueryRange}}/",
    "happy-dom": "npm:happy-dom@{{happyDomRange}}"
  },
  "compilerOptions": {
    "lib": ["deno.ns", "dom", "dom.iterable", "dom.asynciterable"],
    "strict": true
  }
}
