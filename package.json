{
  "name": "@bquery/bquery",
  "version": "1.16.1",
  "description": "bQuery.js \u2014 batteries-included TypeScript framework for the modern web: signals, SSR, Web Components, routing, and more, with a jQuery-inspired API.",
  "type": "module",
  "main": "./dist/full.umd.cjs",
  "module": "./dist/index.es.mjs",
  "types": "./dist/index.d.ts",
  "unpkg": "./dist/full.iife.js",
  "jsdelivr": "./dist/full.iife.js",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.es.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/full.umd.cjs"
      }
    },
    "./full": {
      "import": {
        "types": "./dist/full.d.ts",
        "default": "./dist/full.es.mjs"
      },
      "require": {
        "types": "./dist/full.d.cts",
        "default": "./dist/full.umd.cjs"
      }
    },
    "./core": {
      "import": {
        "types": "./dist/core/index.d.ts",
        "default": "./dist/core.es.mjs"
      }
    },
    "./reactive": {
      "import": {
        "types": "./dist/reactive/index.d.ts",
        "default": "./dist/reactive.es.mjs"
      }
    },
    "./concurrency": {
      "import": {
        "types": "./dist/concurrency/index.d.ts",
        "default": "./dist/concurrency.es.mjs"
      }
    },
    "./component": {
      "import": {
        "types": "./dist/component/index.d.ts",
        "default": "./dist/component.es.mjs"
      }
    },
    "./motion": {
      "import": {
        "types": "./dist/motion/index.d.ts",
        "default": "./dist/motion.es.mjs"
      }
    },
    "./security": {
      "import": {
        "types": "./dist/security/index.d.ts",
        "default": "./dist/security.es.mjs"
      }
    },
    "./platform": {
      "import": {
        "types": "./dist/platform/index.d.ts",
        "default": "./dist/platform.es.mjs"
      }
    },
    "./router": {
      "import": {
        "types": "./dist/router/index.d.ts",
        "default": "./dist/router.es.mjs"
      }
    },
    "./store": {
      "import": {
        "types": "./dist/store/index.d.ts",
        "default": "./dist/store.es.mjs"
      }
    },
    "./view": {
      "import": {
        "types": "./dist/view/index.d.ts",
        "default": "./dist/view.es.mjs"
      }
    },
    "./view/compiler": {
      "import": {
        "types": "./dist/view/compiler/index.d.ts",
        "default": "./dist/view-compiler.es.mjs"
      }
    },
    "./storybook": {
      "import": {
        "types": "./dist/storybook/index.d.ts",
        "default": "./dist/storybook.es.mjs"
      }
    },
    "./forms": {
      "import": {
        "types": "./dist/forms/index.d.ts",
        "default": "./dist/forms.es.mjs"
      }
    },
    "./i18n": {
      "import": {
        "types": "./dist/i18n/index.d.ts",
        "default": "./dist/i18n.es.mjs"
      }
    },
    "./i18n/extract": {
      "import": {
        "types": "./dist/i18n/extract/index.d.ts",
        "default": "./dist/i18n-extract.es.mjs"
      }
    },
    "./a11y": {
      "import": {
        "types": "./dist/a11y/index.d.ts",
        "default": "./dist/a11y.es.mjs"
      }
    },
    "./dnd": {
      "import": {
        "types": "./dist/dnd/index.d.ts",
        "default": "./dist/dnd.es.mjs"
      }
    },
    "./media": {
      "import": {
        "types": "./dist/media/index.d.ts",
        "default": "./dist/media.es.mjs"
      }
    },
    "./plugin": {
      "import": {
        "types": "./dist/plugin/index.d.ts",
        "default": "./dist/plugin.es.mjs"
      }
    },
    "./devtools": {
      "import": {
        "types": "./dist/devtools/index.d.ts",
        "default": "./dist/devtools.es.mjs"
      }
    },
    "./testing": {
      "import": {
        "types": "./dist/testing/index.d.ts",
        "default": "./dist/testing.es.mjs"
      }
    },
    "./ssr": {
      "import": {
        "types": "./dist/ssr/index.d.ts",
        "default": "./dist/ssr.es.mjs"
      }
    },
    "./server": {
      "import": {
        "types": "./dist/server/index.d.ts",
        "default": "./dist/server.es.mjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "bin",
    "README.md",
    "LICENSE.md"
  ],
  "bin": {
    "bquery-view-compile": "bin/bquery-view-compile.mjs",
    "bquery-i18n": "bin/bquery-i18n.mjs"
  },
  "sideEffects": false,
  "scripts": {
    "dev": "vitepress dev docs",
    "docs:dev": "vitepress dev docs",
    "build:docs": "vitepress build docs",
    "docs:build": "vitepress build docs",
    "preview": "vitepress preview docs",
    "docs:preview": "vitepress preview docs",
    "storybook": "storybook dev -p 6006",
    "build:storybook": "storybook build",
    "build": "bun run build:lib && bun run build:umd && bun run build:types",
    "build:lib": "vite build",
    "build:umd": "vite build --config vite.umd.config.ts",
    "build:types": "tsc --emitDeclarationOnly --outDir dist && bun scripts/postbuild-types.mjs && bun scripts/postbuild-cts.mjs",
    "check": "bun run check:ai-guidance && bun run check:full-bundle && bun run check:stability && bun run check:doc-exports && bun run check:theme-links",
    "check:ai-guidance": "bun scripts/check-ai-guidance.mjs",
    "check:full-bundle": "bun scripts/check-full-bundle.mjs",
    "check:stability": "bun scripts/check-stability-matrix.mjs",
    "check:doc-exports": "bun scripts/check-doc-exports.mjs",
    "check:theme-links": "bun scripts/check-theme-links.mjs",
    "check:publint": "publint",
    "check:attw": "attw --pack . --profile esm-only",
    "check:publish": "bun run check:publint && bun run check:attw",
    "docs:check": "bun scripts/check-doc-exports.mjs && bun scripts/check-theme-links.mjs",
    "test": "bun test",
    "test:types": "tsc -p tsconfig.component-test.json --noEmit",
    "test:watch": "bun test --watch",
    "lint": "eslint . --fix",
    "lint:types": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "docs:api": "typedoc",
    "clean": "rimraf dist",
    "prepublishOnly": "bun run clean && bun run build && bun test && bun run check:publish"
  },
  "keywords": [
    "dom",
    "manipulation",
    "jquery",
    "modern",
    "typescript",
    "signals",
    "reactive",
    "components",
    "web-components",
    "animation",
    "motion",
    "zero-build",
    "cdn"
  ],
  "author": "Jonas Pfalzgraf <support@josunlp.de>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bQuery/bQuery.git"
  },
  "homepage": "https://bquery.js.org",
  "bugs": {
    "url": "https://github.com/bQuery/bQuery/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "engines": {
    "node": ">=24.0.0",
    "bun": ">=1.4.0"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@storybook/addon-docs": "^10.5.10",
    "@storybook/web-components-vite": "^10.5.10",
    "@typescript-eslint/eslint-plugin": "^8.68.0",
    "@typescript-eslint/parser": "^8.68.0",
    "bun-types": "^1.4.0",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.11.0",
    "happy-dom": "^20.11.6",
    "prettier": "^3.9.6",
    "publint": "^0.3.24",
    "rimraf": "^6.1.3",
    "storybook": "^10.5.10",
    "typedoc": "^0.28.20",
    "typescript": "^6.0.3",
    "vite": "^8.2.2",
    "vitepress": "^1.6.4"
  }
}
