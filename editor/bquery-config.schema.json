{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://unpkg.com/@bquery/bquery/editor/bquery-config.schema.json",
  "title": "bQuery configuration",
  "$comment": "Generated by scripts/generate-editor-data.mjs from the BqueryConfig interface — do not edit by hand. Function-valued options (pageMeta.titleTemplate) cannot be expressed in JSON and are omitted.",
  "description": "Complete global bQuery configuration object.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "fetch": { "description": "Fetch composable defaults.", "$ref": "#/$defs/BqueryFetchConfig" },
    "cookies": {
      "description": "Cookie composable defaults.",
      "$ref": "#/$defs/BqueryCookieConfig"
    },
    "announcer": {
      "description": "Announcer composable defaults.",
      "$ref": "#/$defs/BqueryAnnouncerConfig"
    },
    "pageMeta": {
      "description": "Page metadata defaults.",
      "$ref": "#/$defs/BqueryPageMetaConfig"
    },
    "transitions": {
      "description": "View transition defaults.",
      "$ref": "#/$defs/BqueryTransitionConfig"
    },
    "components": {
      "description": "Default component library options.",
      "$ref": "#/$defs/BqueryComponentLibraryConfig"
    }
  },
  "$defs": {
    "BqueryFetchConfig": {
      "description": "Global fetch defaults used by useFetch().",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "baseUrl": {
          "description": "Optional base URL prepended to relative request URLs.",
          "type": "string"
        },
        "headers": {
          "description": "Header name → value map, or a list of [name, value] pairs.",
          "anyOf": [
            { "type": "object", "additionalProperties": { "type": "string" } },
            {
              "type": "array",
              "items": {
                "type": "array",
                "items": { "type": "string" },
                "minItems": 2,
                "maxItems": 2
              }
            }
          ]
        },
        "parseAs": {
          "description": "Default response parser.",
          "enum": ["json", "text", "blob", "arrayBuffer", "formData", "response"]
        }
      }
    },
    "BqueryCookieConfig": {
      "description": "Global cookie defaults used by useCookie().",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "path": { "description": "Default cookie path.", "type": "string" },
        "sameSite": { "description": "Default SameSite mode.", "enum": ["Strict", "Lax", "None"] },
        "secure": {
          "description": "Whether cookies should be marked secure by default.",
          "type": "boolean"
        }
      }
    },
    "BqueryAnnouncerConfig": {
      "description": "Global announcer defaults used by useAnnouncer().",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "politeness": {
          "description": "Default politeness level.",
          "enum": ["polite", "assertive"]
        },
        "atomic": {
          "description": "Whether announcements should be treated atomically.",
          "type": "boolean"
        },
        "delay": {
          "description": "Delay before writing the message into the live region.",
          "type": "number"
        },
        "clearDelay": {
          "description": "Delay after which the live region is cleared automatically.",
          "type": "number"
        }
      }
    },
    "BqueryPageMetaConfig": {
      "description": "Global page meta defaults used by definePageMeta().",
      "type": "object",
      "additionalProperties": false,
      "properties": {}
    },
    "BqueryTransitionConfig": {
      "description": "Global motion defaults used by transition().",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "skipOnReducedMotion": {
          "description": "Skip transitions when reduced motion is preferred.",
          "type": "boolean"
        },
        "classes": {
          "description": "Classes applied to the root element during transitions.",
          "type": "array",
          "items": { "type": "string" }
        },
        "types": {
          "description": "Transition type identifiers added when supported by the browser.",
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "BqueryComponentLibraryConfig": {
      "description": "Global default component library configuration.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "prefix": { "description": "Prefix used by registerDefaultComponents().", "type": "string" }
      }
    }
  }
}
